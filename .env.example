# Copy to .env for local development. In production the key is set in the service
# environment — it never lives in this repo.

# Unlimited-tier key minted in AfriRate admin. Without it, rates/inflation/gold
# return 401; countries, currencies and health still work.
AFRIRATE_MCP_API_KEY=

# Upstream REST base. Override only to point at a staging AfriRate.
AFRIRATE_API_BASE=https://afrirate.statotec.com/api/v1

# Local dev port, claimed in the fleet inventory.
PORT=3025
HOST=127.0.0.1

AFRIRATE_TIMEOUT_MS=10000

# How long a rate response may be reused, in ms. The upstream API advertises
# s-maxage=60 on these itself, so 60s is its contract rather than our guess.
# Set to 0 to disable caching of rates (lookups and indicators keep their own,
# longer TTLs).
AFRIRATE_CACHE_TTL_MS=60000

# Where watchlists are stored (one JSON file). Under systemd, StateDirectory=
# sets STATE_DIRECTORY and that is used instead.
AFRIRATE_STATE_DIR=./data
